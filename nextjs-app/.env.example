# PostgreSQL event store + projections (spec §9.2)
DATABASE_URL=postgres://ats:ats@localhost:5439/ats

# 32 random bytes, base64. Wraps every per-candidate data key (spec §9.6).
# Stands in for a KMS key: losing it makes every PII field unreadable.
ATS_MASTER_KEY=<openssl rand -base64 32>

# Staff and candidate session signing
JWT_SECRET=<openssl rand -base64 32>

# Required - the app refuses processor requests without it
BACKGROUND_PROCESSOR_API_KEY=<openssl rand -base64 32>

# Bootstrap platform operator (created/updated at migration time)
PLATFORM_OPERATOR_EMAIL=operator@example.com
PLATFORM_OPERATOR_PASSWORD=<strong password, 12+ chars>

# Public base URL used in emails and feeds
APP_BASE_URL=http://localhost:3000

# Server
PORT=3000
LOG_LEVEL=info   # error | warn | info | debug

# Fake clock for tests only. Never set in production.
# ATS_FAKE_CLOCK=1

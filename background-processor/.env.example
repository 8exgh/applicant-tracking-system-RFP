NEXTJS_API_URL=http://localhost:3000
NEXTJS_API_KEY=<same as BACKGROUND_PROCESSOR_API_KEY in nextjs-app>

POLLING_INTERVAL_MS=5000

# Email provider: log (default, prints IDs only) | smtp
EMAIL_PROVIDER=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Riverbend Careers <no-reply@example.com>"
